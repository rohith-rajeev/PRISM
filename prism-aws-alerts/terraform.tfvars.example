# Copy to terraform.tfvars (which is gitignored) and fill in real webhook URLs,
# or keep it out of tfvars entirely and export as JSON instead:
#   export TF_VAR_chat_targets='[{"name":"chat-a","webhook_url":"https://chat.googleapis.com/...A","branches":["qa","staging","main"]},{"name":"chat-b","webhook_url":"https://chat.googleapis.com/...B","branches":["staging"]}]'

aws_region  = "us-east-1"
name_prefix = "prism-aws-alerts"

# Example matching "chat A gets qa+staging+production, chat B gets staging only,
# and the develop group gets develop only":
chat_targets = [
  {
    name        = "chat-a"
    webhook_url = "https://chat.googleapis.com/v1/spaces/AAAAAAA/messages?key=XXXX&token=YYYY"
    branches    = ["qa", "staging", "main"]
  },
  {
    name        = "chat-b"
    webhook_url = "https://chat.googleapis.com/v1/spaces/BBBBBBB/messages?key=XXXX&token=YYYY"
    branches    = ["staging"]
  },
  # The develop group: watches only develop, so develop merges and deployments
  # never reach the release groups above (and qa/staging/main never reach it).
  {
    name        = "chat-develop"
    webhook_url = "https://chat.googleapis.com/v1/spaces/DDDDDDD/messages?key=XXXX&token=YYYY"
    branches    = ["develop"]
  },
]

watched_repositories = [
  "your-backend-repo",
  "your-frontend-repo",
]

# Which branch each pipeline deploys - drives both the EventBridge watch list
# and the fallback routing for deployments that can't be matched to a PR thread.
pipeline_branches = {
  "your-backend-pipeline-qa"    = "qa"
  "your-backend-pipeline-stg"   = "staging"
  "your-backend-pipeline-prod"  = "main"
  "your-frontend-pipeline-qa"   = "qa"
  "your-frontend-pipeline-stg"  = "staging"
  "your-frontend-pipeline-prod" = "main"
  "your-backend-pipeline-dev"   = "develop"
  "your-frontend-pipeline-dev"  = "develop"
}

# Which repository each pipeline deploys from - used to look up the deployed
# commit's author when no PR-merge thread was recorded.
pipeline_repositories = {
  "your-backend-pipeline-qa"    = "your-backend-repo"
  "your-backend-pipeline-stg"   = "your-backend-repo"
  "your-backend-pipeline-prod"  = "your-backend-repo"
  "your-frontend-pipeline-qa"   = "your-frontend-repo"
  "your-frontend-pipeline-stg"  = "your-frontend-repo"
  "your-frontend-pipeline-prod" = "your-frontend-repo"
  "your-backend-pipeline-dev"   = "your-backend-repo"
  "your-frontend-pipeline-dev"  = "your-frontend-repo"
}

thread_ttl_days           = 30
post_unlinked_deployments = true

tags = {
  Project = "prism-aws-alerts"
}
